{
  "expo": {
    "name": "Atelic_Stable",
    "slug": "Atelic_Stable",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Atelic_logo.png",
    
    "userInterfaceStyle": "light",
    "scheme": "atelicstable",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "AtelicStable",
      "deploymentTarget": "15.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.Atelic_Stable"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
