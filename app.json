{
  "expo": {
    "name": "Atelic",
    "slug": "atelic",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/Atelic_Logo_Zoom.png",

    "userInterfaceStyle": "light",
    "scheme": "atelicstable",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "AtelicStable",
      "deploymentTarget": "15.0",
      "buildNumber": "28",
      "config": {
        "googleMapsApiKey": "AIzaSyCL9ltc7QruVtujOLJ2IBH9Xb9_E5vf5WU"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.atelictravel.atelic",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCL9ltc7QruVtujOLJ2IBH9Xb9_E5vf5WU"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
